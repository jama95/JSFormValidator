{
  "include": ["src/ts/*.ts"],
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM"],
    "forceConsistentCasingInFileNames": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "/types/"
  },
  "exclude": ["src/ts/modifiers.ts"]
}
